# Copy to .env and edit: cp .env.example .env

# Comma-separated host:port values Homepage will answer to.
# Add your server IP and any domain you proxy through Nginx Proxy Manager.
HOMEPAGE_ALLOWED_HOSTS=192.168.0.158:3000,localhost:3000

# Jellyfin: host folder with your media (mounted read-only).
MEDIA_PATH=/srv/media
# GID of the host "render" group, for hardware transcoding: getent group render
RENDER_GID=992
